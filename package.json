{
	"name": "mixlog",
	"version": "1.2.1",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"engines": {
		"node": ">=24.21.0"
	},
	"imports": {
		"#/*": "./src/*",
		"#meter": "./meter/pkg/mixlog_meter.js"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types --strict-vars false",
		"release": "release-it",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration --passWithNoTests",
		"test:tz": "node scripts/test-tz.mjs",
		"meter:build": "sh scripts/meter-build.sh",
		"meter:test": "cargo test --release --manifest-path meter/Cargo.toml",
		"check:time": "node scripts/check-time.mjs",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@fontsource-variable/outfit": "^5.3.0",
		"@fontsource-variable/sora": "^5.3.0",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"framer-motion": "14.9.0",
		"jose": "6.2.14",
		"lucide-react": "1.66.0",
		"mammoth": "1.13.0",
		"pdfjs-dist": "5.4.296",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-pdf": "10.5.0",
		"simple-icons": "16.34.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.66.0",
		"@release-it/keep-a-changelog": "^8.0.1",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^0.31.11",
		"release-it": "^21.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "5.0.5",
		"wrangler": "^4.156.0"
	}
}
