{
	"name": "mixlog",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=22.22.0"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types --strict-vars false",
		"release": "release-it",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration --passWithNoTests",
		"test:tz": "node scripts/test-tz.mjs",
		"check:time": "node scripts/check-time.mjs",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@fontsource-variable/outfit": "^5.3.0",
		"@fontsource-variable/sora": "^5.3.0",
		"@radix-ui/react-dialog": "1.2.0",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"framer-motion": "14.0.0",
		"jose": "6.2.14",
		"lucide-react": "1.64.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@release-it/keep-a-changelog": "^8.0.1",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.11",
		"release-it": "^21.1.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "5.0.5",
		"wrangler": "^4.156.0"
	}
}
