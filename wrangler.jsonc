{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mixlog",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts", // TanStack Start's handler, plus the cleanup cron
	// Failures only: the code logs warnings and errors (src/server/log.ts), never the happy path, so no line per request
	// either. Issues groups errors and 5xx responses; traces sample 1% of requests, enough to see where time goes.
	"observability": {
		"enabled": true,
		"logs": { "invocation_logs": false },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 },
		"issues": { "enabled": true },
	},
	"upload_source_maps": true,

	// `pnpm dev` simulates both locally (.wrangler/state). No database ID: the first deploy creates it and writes it back.
	"d1_databases": [{ "binding": "DB", "database_name": "mixlog", "migrations_dir": "migrations" }],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "mixlog" }],
	// Daily cleanup (src/server.ts): erases versions pruned by Move to Releases once their 14-day grace window has passed.
	"triggers": { "crons": ["0 4 * * *"] },
	// Cloudflare Access: Zero Trust → Access → Applications → your app. Not secrets.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "https://pitoursirak.cloudflareaccess.com",
		"ACCESS_AUD": "6544c11e79935c486b9e5503171004d821c23c791e18174796652fae5fba2c06" // the application's "Application Audience (AUD) Tag"
	},
}
