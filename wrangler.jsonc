{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mixlog",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts", // TanStack Start's handler, plus the cleanup cron
	"preview_urls": false, // Old versions don't stay reachable with production data; nothing uses previews.
	"workers_dev": false, // Only the domain below answers.
	// The app, and the public meter (METER_HOST). Access protects the whole Worker; the meter's host has its own Bypass app.
	"routes": [
		{ "pattern": "themixlog.app", "custom_domain": true },
		{ "pattern": "loudornot.themixlog.app", "custom_domain": true },
	],
	// Failures only: the code logs warnings and errors (src/server/log.ts), never the happy path, so no line per request
	// either. Issues groups errors and 5xx responses; traces sample 1% of requests, enough to see where time goes.
	"observability": {
		"enabled": true,
		"logs": { "invocation_logs": false },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 },
		"issues": { "enabled": true },
	},
	"upload_source_maps": true,

	// `pnpm dev` simulates both locally (.wrangler/state). No database ID: the first deploy creates it and writes it back.
	"d1_databases": [{ "binding": "DB", "database_name": "mixlog", "migrations_dir": "migrations" }],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "mixlog" }],
	// Makes each artwork's small WebP preview (src/server/versions.ts); offline in `pnpm dev`. One transformation per cover.
	"images": { "binding": "IMAGES" },
	// Daily cleanup (src/server.ts): erases versions pruned by Move to Releases once their 14-day grace window has passed.
	"triggers": { "crons": ["0 4 * * *"] },
	// The meter reads whole songs in the Worker (the cron): Workers Paid allows up to 5 minutes of CPU per invocation.
	"limits": { "cpu_ms": 300000 },
	// Cloudflare Access: Zero Trust → Access → Applications → your app. Not secrets.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "https://pitoursirak.cloudflareaccess.com",
		"ACCESS_AUD": "6544c11e79935c486b9e5503171004d821c23c791e18174796652fae5fba2c06", // the application's "Application Audience (AUD) Tag"
		// The public meter's hostname (a Custom Domain in `routes`, bypassed in Access): it serves the meter page and
		// nothing else (src/server/meter-host.ts). Empty in forks that don't want one.
		"METER_HOST": "loudornot.themixlog.app",
	},
}
